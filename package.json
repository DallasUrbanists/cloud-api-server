{
  "name": "urbanists-cloud-api-server",
  "version": "5.4.0",
  "description": "Dallas Urbanists Cloud API Server with Firestore and Google Cloud Run.",
  "author": "Hexel Colorado",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "auth": "gcloud auth application-default login && gcloud config set project urbanists-mixer-slides-helper",
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "docs:dev": "npm run docs:reference && node scripts/docs.mjs dev docs",
    "docs:reference": "typedoc --options typedoc.json",
    "docs:build": "npm run docs:reference && node scripts/docs.mjs build docs",
    "docs:check": "typedoc --options typedoc.json --emit none",
    "docs:preview": "node scripts/docs.mjs preview docs",
    "test": "tsx --test tests/*.test.ts",
    "migrate:staff-claims": "tsx src/scripts/migrateStaffClaims.ts",
    "migrate:recommendable-actions": "tsx src/scripts/migrateRecommendableActions.ts",
    "delete:presentation-test-suggestions": "tsx src/scripts/deletePresentationTestSuggestions.ts",
    "backfill:recommendable-photos": "tsx src/scripts/backfillRecommendablePhotos.ts",
    "start": "node dist/index.js",
    "proxy": "cloud-sql-proxy urbanists-mixer-slides-helper:us-south1:contacts-relationships-db --port 5432",
    "deploy": "gcloud run deploy urbanists-cloud-api-server --source . --region us-central1 --timeout 3600 --allow-unauthenticated --add-cloudsql-instances=urbanists-mixer-slides-helper:us-south1:contacts-relationships-db --update-env-vars SUGGESTION_PHOTOS_BUCKET=urbanists-suggestion-photos,DB_USER=postgres,DB_NAME=postgres,INSTANCE_CONNECTION_NAME=urbanists-mixer-slides-helper:us-south1:contacts-relationships-db --update-secrets DB_PASSWORD=contacts-db-password:latest",
    "major": "npm version major && git push origin main --tags",
    "minor": "npm version minor && git push origin main --tags",
    "patch": "npm version patch && git push origin main --tags",
    "worker:boundaries": "tsx src/scripts/boundaryWorker.ts",
    "scan:recommendables": "tsx src/scripts/recommendableWorker.ts",
    "seed:boundaries": "tsx src/scripts/seedBoundaries.ts",
    "seed:dallas311-recommendables": "tsx src/scripts/seedDallas311Recommendables.ts",
    "eval:emoji": "tsx src/scripts/evaluateSuggestionEmojis.ts",
    "smoke:streetmix": "tsx src/scripts/streetmixSmoke.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.28.0",
    "@turf/boolean-intersects": "^7.3.0",
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "acorn": "^8.19.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "sentence-splitter": "^5.0.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "mermaid": "^12.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    },
    "@grpc/grpc-js": "^1.14.5"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
