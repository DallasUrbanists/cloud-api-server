# Server Configuration
PORT=8080
NODE_ENV=development

# Firestore Configuration
# Optional: Set GCP Project ID if running outside Google Cloud
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: Set service account key file path if running locally
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Primary Firestore Database for Public Improvements
PUBLIC_IMPROVEMENTS_DB=public-improvements
# Local development defaults to the Ideas collection. Deployed bridge services set this explicitly.
IDEAS_DATA_LAYOUT=ideas
IDEA_PHOTOS_BUCKET=urbanists-idea-photos
# Set true on every serving revision only during the coordinated migration cutover.
IDEAS_MAINTENANCE=false

# TV presentation sessions are disabled until the frontend and operators are ready.
PRESENTATION_ENABLED=false
# Presentation WebSockets are an independent opt-in and also require PRESENTATION_ENABLED=true.
PRESENTATION_WEBSOCKET_ENABLED=false

# Coordinate-to-Streetmix generation. Enable only after live compatibility checks.
STREETMIX_ENABLED=false
STREETMIX_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
STREETMIX_OSM_FALLBACK_ENABLED=false
STREETMIX_APP_REQUESTS_PER_MINUTE=10
STREETMIX_GLOBAL_PUBLICATIONS_PER_DAY=100

# CORS Allowed Origins
# Comma-separated list of authorized domains (e.g., https://dallasurbanists.org,https://app.dallasurbanists.org)
# Localhost and local loopback origins (http://localhost:*, http://127.0.0.1:*) are always allowed for development.
ALLOWED_ORIGINS=https://dallasurbanists.org,https://dallasurbanists.github.io,https://dallasurbanists.web.app,https://dallasurbanists.firebaseapp.com

# Authentication
# JSON array of API keys. Store this value in Cloud Run Secret Manager in production.
# Example: [{"name":"checkin-production","key":"replace-with-a-long-random-key"}]
API_KEYS_JSON=[]
# Set to production on Cloud Run to require Firebase App Check on API-key-required endpoints.
# Local development can use a registered Firebase App Check debug token.

# Optional: server-side Google Maps Geocoding API key for representative address search.
# Enable Geocoding API for directory address lookup and Places API (New) for playground autocomplete.
# lat/lon and browser current-location searches do not need this key.
# GOOGLE_MAPS_API_KEY=your-google-maps-geocoding-api-key

# Boundary ticks are disabled until migrations and a durable worker are deployed.
BOUNDARY_SYNC_ENABLED=false
BOUNDARY_SYNC_CLIENT_PER_MINUTE=30
BOUNDARY_SYNC_GLOBAL_PER_MINUTE=10
BOUNDARY_SYNC_GLOBAL_PER_DAY=100
BOUNDARY_SYNC_CONCURRENCY=2
# Maximum new due boundary research jobs per worker scan (1–10000).
BOUNDARY_SYNC_RESEARCH_ENQUEUE_LIMIT=100
BOUNDARY_RESEARCH_MODEL=gemini-3.8-flash
# GOOGLE_MAPS_API_KEY=google-maps-geocoding-api-key
# Acquire provider keys and store them in Secret Manager, not descriptor params.
# CONGRESS_GOV_API_KEY=your-congress-gov-api-key
# OPEN_STATES_API_KEY=your-open-states-api-key
# GEMINI_API_KEY=your-gemini-api-key
# TYPESAFE_API_KEY=your-typesafe-api-key
# Use a dedicated least-privilege server key; never send this value to clients.
# RECOMMENDABLE_EXTRACTION_MODEL=gemini-3.8-flash
# TYPESAFE_MODEL=jev-latest
# Exact reviewed organization website hosts, comma-separated; no wildcards.
# BOUNDARY_RESEARCH_ALLOWED_HOSTS=www.verified-association.example.org

# Firebase browser configuration used by Swagger sign-in and App Check.
# These are public browser configuration values, not server secrets.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=your-firebase-web-app-id
# Match the provider registered for this web app in Firebase Console > App Check.
# Accepted values: recaptcha-v3 (default), recaptcha-enterprise.
FIREBASE_APPCHECK_PROVIDER=recaptcha-v3
# Site key for the selected provider; never put the secret key here.
FIREBASE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Set to true to show the Firebase Google and email/password sign-in helper in Swagger UI.
ENABLE_SWAGGER_FIREBASE_AUTH=false
