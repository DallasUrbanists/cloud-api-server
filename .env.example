# Server Configuration
PORT=8080
NODE_ENV=development

# Firestore Configuration
# Optional: Set GCP Project ID if running outside Google Cloud
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: Set service account key file path if running locally
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Primary Firestore Database for Public Improvements
PUBLIC_IMPROVEMENTS_DB=public-improvements

# CORS Allowed Origins
# Comma-separated list of authorized domains (e.g., https://dallasurbanists.org,https://app.dallasurbanists.org)
# Localhost and local loopback origins (http://localhost:*, http://127.0.0.1:*) are always allowed for development.
ALLOWED_ORIGINS=https://dallasurbanists.org,https://dallasurbanists.github.io,https://dallasurbanists.web.app,https://dallasurbanists.firebaseapp.com

# Authentication
# JSON array of API keys. Store this value in Cloud Run Secret Manager in production.
# Example: [{"name":"checkin-production","key":"replace-with-a-long-random-key"}]
API_KEYS_JSON=[]
# Set to production on Cloud Run to require Firebase App Check on API-key-required endpoints.
# Local development can use a registered Firebase App Check debug token.

# Firebase Web API key used only by the local Swagger sign-in helper.
# This is a browser API key, not a server secret.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
